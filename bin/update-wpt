#!/usr/bin/env python3
"""Update the shared WPT checkout and refresh Olive's WPT baseline inventory."""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path, PurePosixPath


TAG_PATTERN = re.compile(r"^merge_pr_(\d+)$")
DEFAULT_WPT_ROOT = Path.home() / "chromium-repos/wpt"
IGNORED_PATH_PARTS = {"tools"}
SUCCESSFUL_REFERENCE_STATUSES = {"ok", "ok_with_request_failures", "skipped_existing"}


def run(command: list[str], *, cwd: Path | None = None) -> str:
    result = subprocess.run(
        command,
        cwd=cwd,
        check=True,
        text=True,
        stdout=subprocess.PIPE,
    )
    return result.stdout


def latest_wpt_tag(wpt_root: Path, remote: str) -> str:
    output = run(
        ["git", "ls-remote", "--tags", remote, "refs/tags/merge_pr_*"],
        cwd=wpt_root,
    )
    candidates: list[tuple[int, str]] = []
    for line in output.splitlines():
        fields = line.split("\t")
        if len(fields) != 2:
            continue
        reference = fields[1].removesuffix("^{}")
        tag = reference.removeprefix("refs/tags/")
        match = TAG_PATTERN.fullmatch(tag)
        if match:
            candidates.append((int(match.group(1)), tag))
    if not candidates:
        raise RuntimeError(f"no merge_pr_* tags found on WPT remote {remote}")
    return max(candidates)[1]


def checkout_wpt_tag(wpt_root: Path, remote: str, tag: str) -> str:
    status = run(["git", "status", "--porcelain"], cwd=wpt_root).splitlines()
    unexpected = [line for line in status if not line.endswith(" .olive-wpt-revision")]
    if unexpected:
        details = "\n".join(unexpected)
        raise RuntimeError(f"WPT checkout has unexpected local changes:\n{details}")

    run(
        [
            "git",
            "fetch",
            "--depth=1",
            "--no-tags",
            remote,
            f"refs/tags/{tag}:refs/tags/{tag}",
        ],
        cwd=wpt_root,
    )
    run(["git", "checkout", "--detach", "--force", tag], cwd=wpt_root)
    for local_tag in run(["git", "tag", "--list"], cwd=wpt_root).splitlines():
        if local_tag != tag:
            run(["git", "tag", "--delete", local_tag], cwd=wpt_root)
    commit = run(["git", "rev-parse", "HEAD"], cwd=wpt_root).strip()
    count = run(["git", "rev-list", "--count", "HEAD"], cwd=wpt_root).strip()
    if count != "1":
        raise RuntimeError(
            f"WPT checkout is not a one-commit shallow checkout after selecting {tag}: {count} commits"
        )
    (wpt_root / ".olive-wpt-revision").write_text(f"{tag}\n", encoding="utf-8")
    return commit


def discover(olive_root: Path, wpt_root: Path, tag: str, report: Path) -> dict[str, object]:
    report.parent.mkdir(parents=True, exist_ok=True)
    run(
        [
            str(olive_root / "bin/discover-chromium-wpt"),
            "--wpt-root",
            str(wpt_root),
            "--wpt-revision",
            tag,
            "--pretty",
            "--output",
            str(report),
        ],
        cwd=olive_root,
    )
    return json.loads(report.read_text(encoding="utf-8"))


def inventory_paths(report: dict[str, object]) -> list[str]:
    paths: set[str] = set()
    for test in report.get("tests", []):
        if not isinstance(test, dict) or not isinstance(test.get("path"), str):
            raise RuntimeError("WPT discovery report contains an invalid test entry")
        path = PurePosixPath(test["path"])
        if any(part in IGNORED_PATH_PARTS for part in path.parts):
            continue
        paths.add(path.as_posix())
    if not paths:
        raise RuntimeError("WPT discovery produced no reftest paths")
    return sorted(paths)


def write_inventory(path: Path, paths: list[str]) -> None:
    path.write_text(
        "# Generated by bin/update-wpt from literal rel=match/rel=mismatch links.\n"
        + "\n".join(paths)
        + "\n",
        encoding="utf-8",
    )


def failed_reference_paths(report: dict[str, object], paths: list[str]) -> list[str]:
    results = report.get("results")
    if not isinstance(results, list):
        raise RuntimeError("reference-generation report has no results list")
    statuses: dict[str, str] = {}
    for result in results:
        if not isinstance(result, dict):
            raise RuntimeError("reference-generation report contains an invalid result")
        path = result.get("path")
        status = result.get("status")
        if not isinstance(path, str) or not isinstance(status, str):
            raise RuntimeError("reference-generation report contains an incomplete result")
        statuses[path] = status
    return sorted(
        path
        for path in paths
        if statuses.get(path) not in SUCCESSFUL_REFERENCE_STATUSES
    )


def write_failed_references(path: Path, failed_paths: list[str]) -> None:
    path.write_text(
        "# WPT paths whose Chromium reference could not be generated.\n"
        "# Generated by bin/update-wpt; rerun the updater to retry them.\n"
        + "\n".join(failed_paths)
        + ("\n" if failed_paths else ""),
        encoding="utf-8",
    )


def output_directory(output_root: Path, wpt_path: str) -> Path:
    source = PurePosixPath(wpt_path)
    suffix = source.suffix.removeprefix(".")
    stem = source.name[: -(len(suffix) + 1)] if suffix else source.name
    name = f"{stem}-{suffix}-test" if suffix else f"{stem}-test"
    return output_root.joinpath(*source.parts[:-1], name)


def prune_stale_output_directories(output_root: Path, paths: list[str]) -> int:
    expected = {
        output_directory(output_root, path).relative_to(output_root)
        for path in paths
    }
    expected_prefixes: set[Path] = set()
    for directory in expected:
        for index in range(1, len(directory.parts) + 1):
            expected_prefixes.add(Path(*directory.parts[:index]))
    removed = 0
    candidates = sorted(
        (directory for directory in output_root.rglob("*") if directory.is_dir()),
        key=lambda directory: len(directory.parts),
        reverse=True,
    )
    for directory in candidates:
        if not directory.name.endswith("-test"):
            continue
        relative = directory.relative_to(output_root)
        if relative in expected_prefixes:
            continue
        shutil.rmtree(directory)
        removed += 1

    for directory in sorted(
        (directory for directory in output_root.rglob("*") if directory.is_dir()),
        key=lambda directory: len(directory.parts),
        reverse=True,
    ):
        relative = directory.relative_to(output_root)
        if relative in expected_prefixes:
            continue
        try:
            directory.rmdir()
        except OSError:
            pass
    return removed


def arguments() -> argparse.Namespace:
    project_root = Path(__file__).resolve().parents[2]
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--olive-root", type=Path, default=project_root)
    parser.add_argument(
        "--wpt-root",
        type=Path,
        default=Path(os.environ.get("OLIVE_WPT_ROOT", DEFAULT_WPT_ROOT)),
    )
    parser.add_argument("--remote", default="origin")
    parser.add_argument("--chromium", default=os.environ.get("OLIVE_CHROMIUM_BIN"))
    parser.add_argument("--workers", type=int, default=8)
    parser.add_argument("--timeout-ms", type=int, default=3_000)
    return parser.parse_args()


def main() -> int:
    args = arguments()
    submodule_root = Path(__file__).resolve().parents[1]
    output_root = submodule_root / "outputs"
    report = submodule_root / "current" / "wpt-discovery.json"
    all_paths_file = submodule_root / "current" / "wpt_paths-before-reference-filter.txt"
    generation_report = submodule_root / "current" / "reference-generation.json"
    try:
        tag = latest_wpt_tag(args.wpt_root, args.remote)
        commit = checkout_wpt_tag(args.wpt_root, args.remote, tag)
        discovery = discover(args.olive_root, args.wpt_root, tag, report)
        discovered_paths = inventory_paths(discovery)
        write_inventory(all_paths_file, discovered_paths)

        command = [
            "uv",
            "run",
            "--project",
            str(args.olive_root),
            "--group",
            "dev",
            "python",
            str(args.olive_root / "bin/generate-wpt-reference-screenshots.py"),
            "--paths-file",
            str(all_paths_file),
            "--output-root",
            str(output_root),
            "--report",
            str(generation_report),
            "--workers",
            str(args.workers),
            "--timeout-ms",
            str(args.timeout_ms),
        ]
        if args.chromium:
            command.extend(["--chromium", args.chromium])
        generation = subprocess.run(command, cwd=args.olive_root)
        if generation.returncode not in {0, 1}:
            raise subprocess.CalledProcessError(generation.returncode, command)
        generation_results = json.loads(generation_report.read_text(encoding="utf-8"))
        failed = failed_reference_paths(generation_results, discovered_paths)
        paths = [path for path in discovered_paths if path not in set(failed)]
        write_inventory(submodule_root / "wpt_paths.txt", paths)
        write_failed_references(submodule_root / "failed-references.txt", failed)
        removed = prune_stale_output_directories(output_root, paths)
    except (OSError, RuntimeError, subprocess.CalledProcessError, json.JSONDecodeError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 1

    print(
        f"WPT_UPDATE tag={tag} commit={commit} paths={len(paths)} "
        f"failed_references={len(failed)} "
        f"pruned_output_dirs={removed} report={report}"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
